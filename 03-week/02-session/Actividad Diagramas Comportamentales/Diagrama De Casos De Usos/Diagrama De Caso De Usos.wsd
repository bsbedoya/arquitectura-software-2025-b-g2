@startuml
left to right direction
actor Cliente
actor "Administrador" as Admin
actor "Sistema de Pago" as Pago
actor "Sistema de Inventario" as Inventario

rectangle "Carrito de Compras" {
  usecase "Registrar cuenta" as UC1
  usecase "Iniciar sesión" as UC2
  usecase "Explorar productos" as UC3
  usecase "Agregar producto al carrito" as UC4
  usecase "Eliminar producto del carrito" as UC5
  usecase "Actualizar cantidad" as UC6
  usecase "Ver carrito" as UC7
  usecase "Realizar compra" as UC8
  usecase "Seleccionar método de pago" as UC9
  usecase "Procesar pago" as UC10
  usecase "Confirmar compra" as UC11
  usecase "Recibir notificación" as UC12
  usecase "Gestionar productos" as UC13
  usecase "Actualizar inventario" as UC14
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Cliente --> UC7
Cliente --> UC8
Cliente --> UC9
Cliente --> UC12

UC8 --> UC10 : <<include>>
UC10 --> Pago
UC8 --> UC11 : <<include>>
UC4 --> Inventario : <<include>>
UC13 --> UC14
Admin --> UC13

database "Base de Datos" as DB

@enduml